# Base URL of the Bopster read API the MCP server proxies (no trailing slash).
BOPSTER_API_URL=https://api.bopster.fun

# Only for the official server: a secret shared with the Bopster API (X-Bopster-Mcp-Secret), at
# least 32 bytes, so the API rate-limits this server apart from per-IP traffic. Only ever sent to
# BOPSTER_API_URL. Leave it empty on your own server.
BOPSTER_MCP_SECRET=

# Per-request timeout when calling the backend, in milliseconds.
BOPSTER_HTTP_TIMEOUT_MS=10000

# Port the HTTP (Streamable HTTP) transport listens on. Bound to 127.0.0.1 in Docker.
MCP_PORT=8788

# 8453 = Base mainnet, 84532 = Base Sepolia.
BOPSTER_CHAIN_ID=8453

# Base JSON-RPC endpoint for contract reads. The public one answers bursts with
# "over rate limit"; use a dedicated endpoint in production. It must return transaction
# receipts (publicnode's free tier doesn't): market creation and sync_market read them.
BOPSTER_RPC_URL=https://mainnet.base.org

# BopsterFactory on Base mainnet. get_fees and the quote_/prepare_/sync_ tools need it.
BOPSTER_FACTORY_ADDRESS=0x11a2a549286567f7427d990423e5a3560ea16750

# Arbitrator for new markets' Reality.eth questions. Leave empty to turn market creation off.
BOPSTER_REALITY_ARBITRATOR=0xcB4B48d2A7a44247A00048963F169d2b4Ab045a6

# Reality.eth answer window and bounty for new questions (12 h and none, as on the site).
BOPSTER_REALITY_TIMEOUT_SECONDS=43200
BOPSTER_REALITY_ANSWER_REWARD_WEI=0

# Where market links in tool output point.
BOPSTER_SITE_URL=https://bopster.fun

# Signs market drafts between prepare_market_question and prepare_market_launch, so only
# template questions this server built can be launched. Any long random string; unset, a
# random key is made per process and drafts don't survive a restart. At least 32 bytes:
# openssl rand -hex 32
BOPSTER_DRAFT_SECRET=
